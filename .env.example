# LLM 模型配置
API_KEY=your-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen3.6-flash

# ==================== Embedding 配置 ====================
# backend 可选值:
#   api    - 通过 OpenAI 兼容 API 调用(推荐,零配置)
#   local  - 本地加载模型(需下载模型,零 API 费用)
EMBEDDING_BACKEND=api

# API 模式:填写远程模型名称(如 DashScope 的 text-embedding-v3)
EMBEDDING_MODEL_ID=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-api-key-here

# Local 模式:填写本地模型路径(需先用 ModelScope 或 HuggingFace 下载)
# EMBEDDING_MODEL_ID=./data/embedding_models/models/BAAI--bge-large-zh/snapshots/master
# EMBEDDING_CACHE_DIR=./data/embedding_models
