# LLM 模型配置
API_KEY=your-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-plus
EMBEDDING_MODEL_ID=text-embedding-v3

# 项目配置（可选）
# PROJECT_NAME=MindBridge 心理测评与智能问答系统
# DEBUG=false
# EMBEDDING_TIMEOUT_SECONDS=30

# 数据库与缓存（Docker 环境下自动注入，无需配置）
# DATABASE_URL=mysql+aiomysql://root:root@mysql:3306/mindbridge?charset=utf8mb4
# REDIS_URL=redis://redis:6379/1

# 向量数据库（可选）
# CHROMA_PERSIST_DIR=./data/chroma_db
# CHROMA_COLLECTION_NAME=mindbridge_knowledge

# 其他配置（可选）
# ALERT_EMAIL_DELIVERY_MODE=log
# EXCEL_PATH=./data/excel_ledger/risk_ledger.xlsx
# WORKER_POLL_INTERVAL=5
# MAX_TASK_ATTEMPTS=3
